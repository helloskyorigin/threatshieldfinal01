# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
GROQ_API_KEY=your_api_key_here
GOOGLE_WEB_RISK_API_KEY=your_web_risk_key_here
GOOGLE_WEB_CLIENT_ID=your_firebase_web_client_id_here
URLHAUS_API_KEY=your_urlhaus_api_key_here
PHISHTANK_API_KEY=your_phishtank_api_key_here

# RELEASE_ADMOB_APP_ID: The real AdMob App ID for production release builds.
RELEASE_ADMOB_APP_ID=ca-app-pub-9554102514624306~1748117938

# RELEASE_BANNER_AD_UNIT_ID: The real Banner Ad Unit ID for production release builds.
RELEASE_BANNER_AD_UNIT_ID=ca-app-pub-9554102514624306/8741615708

# RELEASE_REWARDED_AD_UNIT_ID: The real Rewarded Ad Unit ID for production release builds.
RELEASE_REWARDED_AD_UNIT_ID=ca-app-pub-9554102514624306/6963564405
